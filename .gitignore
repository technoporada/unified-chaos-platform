chaos_server.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temp
*.tmp
*.bak
*.orig

# Coverage
.coverage
htmlcov/
.coverage.*

# Testing
.pytest_cache/
.coverage
htmlcov/

# Config (user-specific)
config.local.json

# Archives
*.tar.gz
*.zip
